{
  "name": "meta",
  "description": "Datos generales del documento.",
  "properties": {
    "name": { "type": "string", "default": "Sin nombre", "group": "General", "description": "Nombre visible del personaje." },
    "width": { "type": "number", "default": 800, "min": 1, "group": "Lienzo", "description": "Ancho del lienzo en px." },
    "height": { "type": "number", "default": 800, "min": 1, "group": "Lienzo", "description": "Alto del lienzo en px." },
    "background": { "type": "color", "default": "#f4f1ea", "nullable": true, "group": "Lienzo", "description": "Color de fondo. null = transparente." },
    "fps": { "type": "number", "default": 24, "min": 1, "max": 120, "integer": true, "group": "Tiempo", "description": "Frames por segundo. Solo sirven para mostrar frames y para el snapping; el tiempo se guarda en segundos." }
  }
}
