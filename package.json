{
  "name": "aia-studio",
  "private": true,
  "version": "0.2.0",
  "description": "A 2D drawing, animation and character tool made for AI first, fully editable by a human (HTML, CSS, JS and SVG).",
  "license": "MIT",
  "author": "pederseo-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pederseo-dev/aia-studio.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/app.js",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "dev.pederseo.aia-studio",
    "productName": "aia-studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "dist/**",
      "electron/**",
      "server/**",
      "src/core/**",
      "schema/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "aia-studio-Setup-${version}.exe"
    }
  }
}
